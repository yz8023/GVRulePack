<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.GVRulePack">

        <!-- 工坊入口：导入规则、生成独立模块 APK -->
        <activity
            android:name=".host.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".host.ExportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 生成的 APK 通过 FileProvider 分享 -->
        <provider
            android:name="io.github.gvrulepack.app.host.GvFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
