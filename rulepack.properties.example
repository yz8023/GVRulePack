# =============================================================================
# GV 规则工坊 自定义打包配置（复制本文件为 rulepack.properties 后修改）
#
#   cp rulepack.properties.example rulepack.properties
#   python3 pack.py
#
# 注意：这里配置的是「工厂 App」自身的身份。
# 生成的模块 APK 的包名/名称/版本在手机上导出时填写。
# =============================================================================

# 工厂包名
applicationId=io.github.gvrulepack.app
# 工厂显示名
appLabel=GV 规则工坊
# 版本
versionCode=8
versionName=1.2.5
# 输出文件名（留空 = <应用名>-<版本>.apk）
outputName=

# 工厂自身签名（留空 = debug 签名；'auto' = 自动生成并复用）
keystore=
keystorePassword=
keyAlias=
keyPassword=
